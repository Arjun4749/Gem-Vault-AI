rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public read for profile info, authenticated self update
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(userId);
      allow delete: if false;
    }

    // Certificates can be verified publicly by ID
    match /certificates/{certificateId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(certificateId);
      allow delete: if false;
    }

    // Gemological reports list and details
    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(reportId);
      allow delete: if false;
    }
  }
}
